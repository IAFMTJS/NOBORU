# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# In Supabase Dashboard → Authentication → URL Configuration, add:
# - Site URL: http://localhost:3000 (local) or your Vercel production URL
# - Redirect URLs:
#   - http://localhost:3000/auth/callback
#   - https://<your-project>.vercel.app/auth/callback
#
# Vercel: set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
# in Project Settings → Environment Variables for Production and Preview.

# Public beta (Phase 24) — set true only for beta deployments
NEXT_PUBLIC_BETA_MODE=false
NEXT_PUBLIC_BETA_VERSION=0.24.0-beta

# Lighthouse CI (optional) — dedicated test user with onboarding completed
# LIGHTHOUSE_TEST_EMAIL=lighthouse@example.com
# LIGHTHOUSE_TEST_PASSWORD=your-test-password
# LIGHTHOUSE_BASE_URL=http://127.0.0.1:3000
# LIGHTHOUSE_LESSON_ID=uuid-of-published-fixture-lesson

# Official release (Phase 25)
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_LAUNCH_DATE=2026-06-08
# NEXT_PUBLIC_APP_URL=https://noboru.app
