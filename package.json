{
  "name": "noboru",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "node scripts/art-direction/publish-art-library.mjs && next build",
    "predev": "node scripts/art-direction/publish-art-library.mjs --if-needed",
    "analyze": "node -e \"process.env.ANALYZE='true'; require('child_process').execSync('next build', {stdio:'inherit', env:process.env})\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:validate": "node scripts/art-direction/validate-mappings.mjs",
    "assets:publish-library": "node scripts/art-direction/publish-art-library.mjs",
    "assets:audit-immersion": "node scripts/art-direction/audit-immersion.mjs",
    "assets:generate": "node scripts/art-direction/generate.mjs",
    "assets:publish-source": "node scripts/art-direction/publish-source.mjs",
    "assets:ingest-staging": "node scripts/art-direction/ingest-staging.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.19",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.15",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
