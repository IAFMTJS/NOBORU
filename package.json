  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "analyze": "node -e \"process.env.ANALYZE='true'; require('child_process').execSync('next build', {stdio:'inherit', env:process.env})\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:webp": "node scripts/convert-assets-to-webp.mjs",
    "assets:stickers": "node scripts/process-sticker-assets.mjs",
    "assets:nav-icons": "node scripts/generate-nav-icons.mjs && node scripts/process-sticker-assets.mjs",
    "assets:minigame-art": "node scripts/install-minigame-art.mjs && node scripts/process-sticker-assets.mjs",
    "assets:scenes": "node scripts/convert-scene-assets.mjs",
    "assets:region-scrolls": "node scripts/generate-region-trail-scrolls.mjs && node scripts/convert-scene-assets.mjs",
    "assets:trail-scroll": "node scripts/finalize-trail-scroll-art.mjs && node scripts/convert-scene-assets.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.19",
